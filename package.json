{
  "name": "smartretailx",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "infrastructure"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cdk:synth": "npm --workspace infrastructure run synth",
    "cdk:diff": "npm --workspace infrastructure run diff",
    "cdk:deploy": "npm --workspace infrastructure run deploy",
    "cdk:destroy": "npm --workspace infrastructure run destroy"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "aws-cdk": "^2.1135.1",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.263.0",
    "constructs": "^10.8.1"
  }
}
